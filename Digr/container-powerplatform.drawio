<mxCell id="title" value="&lt;b&gt;Container Diagram — btg-devops with Power Platform Analysis&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1A2B3A&quot;&gt;[C4 Level 2 — all-in-one clear view]&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="1800" height="55" as="geometry" /></mxCell>
<mxCell id="boundary" value="btg-devops + Power Platform Governance [Single Diagram Boundary]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#161E24;strokeColor=#BBBBBB;strokeWidth=2;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="1720" height="990" as="geometry" /></mxCell>
<mxCell id="sec1" value="Users &amp; Entry Points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2D36;strokeColor=#59636E;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="370" height="875" as="geometry" /></mxCell>
<mxCell id="sec2" value="Shared Analysis Core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2D36;strokeColor=#59636E;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="520" height="875" as="geometry" /></mxCell>
<mxCell id="sec3" value="API / Auth Layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2D36;strokeColor=#59636E;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1020" y="140" width="330" height="875" as="geometry" /></mxCell>
<mxCell id="sec4" value="External Systems &amp; Outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2D36;strokeColor=#59636E;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1380" y="140" width="340" height="875" as="geometry" /></mxCell>
<mxCell id="dev" value="DevOps Engineer&lt;br&gt;[Person]&lt;br&gt;Runs CLI commands from terminal." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#7EBBEE;strokeColor=#528BBC;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="105" y="200" width="300" height="95" as="geometry" /></mxCell>
<mxCell id="cli" value="CLI Interface&lt;br&gt;[Go / Cobra]&lt;br&gt;Routes analyze commands, including analyze powerplatform." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#438DD5;strokeColor=#2E6DA4;" vertex="1" parent="1"><mxGeometry x="105" y="340" width="300" height="115" as="geometry" /></mxCell>
<mxCell id="dashuser" value="Dashboard User&lt;br&gt;[Person]&lt;br&gt;Reviews findings in browser." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#7EBBEE;strokeColor=#528BBC;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="105" y="525" width="300" height="95" as="geometry" /></mxCell>
<mxCell id="next" value="Next.js Dashboard&lt;br&gt;[TypeScript / Vercel]&lt;br&gt;Normal Mode displays JSON findings. Agent Mode sends prompts to Claude." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#8E44AD;strokeColor=#6C3483;" vertex="1" parent="1"><mxGeometry x="105" y="665" width="300" height="120" as="geometry" /></mxCell>
<mxCell id="azeng" value="Azure Analysis Engine&lt;br&gt;[Existing Go analyzers]&lt;br&gt;Checks existing Azure resources and applies severity rules." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#438DD5;strokeColor=#2E6DA4;" vertex="1" parent="1"><mxGeometry x="520" y="205" width="410" height="125" as="geometry" /></mxCell>
<mxCell id="ppeng" value="Power Platform Analyzer&lt;br&gt;[New Go analyzer]&lt;br&gt;Checks Power Apps, flows, DLP policies, Dataverse metadata and Power BI health." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#2E8B57;strokeColor=#1E6B3D;" vertex="1" parent="1"><mxGeometry x="520" y="390" width="410" height="135" as="geometry" /></mxCell>
<mxCell id="out" value="Output Formatter&lt;br&gt;[Shared Go output]&lt;br&gt;Renders Critical / Warning / Info findings as table or JSON." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#438DD5;strokeColor=#2E6DA4;" vertex="1" parent="1"><mxGeometry x="520" y="595" width="410" height="125" as="geometry" /></mxCell>
<mxCell id="api" value="MCP Server + HTTP API Server&lt;br&gt;[Go / MCP + REST]&lt;br&gt;HTTP API serves dashboard JSON. MCP tools allow Claude Agent to request analysis." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#E67E22;strokeColor=#CA6F1E;" vertex="1" parent="1"><mxGeometry x="520" y="800" width="410" height="105" as="geometry" /></mxCell>
<mxCell id="azsdk" value="Azure SDK Layer&lt;br&gt;[azure-sdk-for-go]&lt;br&gt;Reads Azure resource configuration and metrics where required." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#438DD5;strokeColor=#2E6DA4;" vertex="1" parent="1"><mxGeometry x="1060" y="205" width="250" height="115" as="geometry" /></mxCell>
<mxCell id="ppclient" value="Power Platform API Client&lt;br&gt;[REST client]&lt;br&gt;Gets tokens and calls Power Platform Admin API and Power BI REST API." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#2E8B57;strokeColor=#1E6B3D;" vertex="1" parent="1"><mxGeometry x="1060" y="390" width="250" height="125" as="geometry" /></mxCell>
<mxCell id="entra" value="Microsoft Entra ID / Azure AD&lt;br&gt;[Identity Provider]&lt;br&gt;Issues OAuth2 tokens for Azure, Power Platform and Power BI APIs." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#6F6F6F;strokeColor=#3A3A3A;" vertex="1" parent="1"><mxGeometry x="1060" y="595" width="250" height="125" as="geometry" /></mxCell>
<mxCell id="ci" value="GitHub Actions CI&lt;br&gt;[CI/CD]&lt;br&gt;Runs checks and can schedule read-only analysis later." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#6F6F6F;strokeColor=#3A3A3A;" vertex="1" parent="1"><mxGeometry x="1060" y="805" width="250" height="100" as="geometry" /></mxCell>
<mxCell id="arm" value="Azure Resource Manager&lt;br&gt;[External System]&lt;br&gt;Returns Azure resource data." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#6F6F6F;strokeColor=#3A3A3A;" vertex="1" parent="1"><mxGeometry x="1425" y="185" width="250" height="100" as="geometry" /></mxCell>
<mxCell id="ppapi" value="Power Platform Admin API&lt;br&gt;[External System]&lt;br&gt;Returns environments, apps, flows, DLP policies and Dataverse metadata." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#6F6F6F;strokeColor=#3A3A3A;" vertex="1" parent="1"><mxGeometry x="1425" y="330" width="250" height="110" as="geometry" /></mxCell>
<mxCell id="pbi" value="Power BI REST API&lt;br&gt;[External System]&lt;br&gt;Returns workspaces, datasets, reports and refresh history." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#6F6F6F;strokeColor=#3A3A3A;" vertex="1" parent="1"><mxGeometry x="1425" y="485" width="250" height="105" as="geometry" /></mxCell>
<mxCell id="claude" value="Claude Agent&lt;br&gt;[External System]&lt;br&gt;Calls MCP tools and explains findings in plain English." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#7EBBEE;strokeColor=#528BBC;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1425" y="650" width="250" height="105" as="geometry" /></mxCell>
<mxCell id="viz" value="Dashboard / Grafana Output&lt;br&gt;[Visualization]&lt;br&gt;Shows JSON or metrics findings after dashboard approach is confirmed." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fontColor=#ffffff;fillColor=#8E44AD;strokeColor=#6C3483;" vertex="1" parent="1"><mxGeometry x="1425" y="805" width="250" height="105" as="geometry" /></mxCell>
